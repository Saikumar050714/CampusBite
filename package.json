{
  "name": "campusbite-canteen",
  "version": "1.0.0",
  "description": "College Canteen Pre-order & Queue Management Web Application",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "canteen",
    "preorder",
    "queue-management",
    "pin-verification",
    "socketio",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
